# ==============================================================================
# AYOJIT INTELLIGENCE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# --- 1. APPLICATION & SYSTEM ENVIRONMENT ---
NODE_ENV=production
PORT=3000
HTTP_PORT=80
APP_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost

# --- 2. RELATIONAL DATABASE (POSTGRESQL) ---
POSTGRES_USER=ayojit
POSTGRES_PASSWORD=ayojit_secure_password_2026
POSTGRES_DB=ayojit_lms
DATABASE_URL=postgresql://ayojit:ayojit_secure_password_2026@postgres:5432/ayojit_lms?schema=public
AUTO_SEED=true

# --- 3. IN-MEMORY CACHE & DISTRIBUTED LOCKS (REDIS) ---
REDIS_URL=redis://redis:6379

# --- 4. PYTHON PAPERFETCHER MICROSERVICE ---
PAPERFETCHER_API_URL=http://paperfetcher:5000/api

# --- 5. AUTHENTICATION & CRYPTOGRAPHIC SECRETS ---
JWT_SECRET=ayojit_master_jwt_secret_2026_production_change_me
NEXTAUTH_SECRET=ayojit_nextauth_secret_key_2026_change_me
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=ayojit_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRE=30d

# --- 6. MULTI-CLOUD STORAGE ADAPTER (local | r2 | oracle | storj) ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/storage
# Cloudflare R2 (Optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Oracle OCI Object Storage (Optional)
OCI_TENANCY=
OCI_USER=
OCI_REGION=ap-mumbai-1
OCI_BUCKET=
# Storj DCS (Optional)
STORJ_ACCESS_GRANT=
STORJ_BUCKET=

# --- 7. TRANSACTIONAL EMAIL (ZOHO MAIL API) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_EMAIL=notifications@ayojitintelligence.com

# --- 8. VIDEO HOSTING & STREAMING INTEGRATIONS ---
YOUTUBE_API_KEY=
VIMEO_ACCESS_TOKEN=
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=

# --- 9. STATUTORY COMPLIANCE & SECURITY GOVERNANCE ---
REQUIRE_CONSENT_LOGIN=true
DPDP_COMPLIANCE_MODE=strict
ACADEMIC_INTEGRITY_LEVEL=zero_ghostwriting
